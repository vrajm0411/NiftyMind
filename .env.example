# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/niftymind"

# Auth
JWT_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Upstox API (https://upstox.com/developer/apps)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:3000/api/auth/upstox/callback"

# AI — Groq (https://console.groq.com/keys)
GROQ_API_KEY=""

# Fundamentals fallback — Apify (optional)
APIFY_API_TOKEN=""

# Cloudflare Turnstile (optional, bot protection on auth forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
