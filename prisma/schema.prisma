generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  mobile            String
  passwordHash      String
  upstoxApiKey      String?
  upstoxApiSecret   String?
  upstoxAccessToken String?
  upstoxTokenSetAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}
